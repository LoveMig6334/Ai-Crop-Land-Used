\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Rolling-Window LSTM forecast vs.\ actual prices for all four crops (2024 test year) with peak month annotations. Arrows indicate the predicted and actual peak months. Cassava and green bean achieve exact peak timing ($\Delta $Month\,=\,0), soybean is within one month ($\Delta $Month\,=\,1), while corn's peak is five months off ($\Delta $Month\,=\,5). This peak timing property---rather than overall MAPE---determines the quality of the downstream scheduling system.}}{11}{figure.15}\protected@file@percent }
\newlabel{fig:rwlstm_all}{{15}{11}{Rolling-Window LSTM forecast vs.\ actual prices for all four crops (2024 test year) with peak month annotations. Arrows indicate the predicted and actual peak months. Cassava and green bean achieve exact peak timing ($\Delta $Month\,=\,0), soybean is within one month ($\Delta $Month\,=\,1), while corn's peak is five months off ($\Delta $Month\,=\,5). This peak timing property---rather than overall MAPE---determines the quality of the downstream scheduling system}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Normalized RW-LSTM forecasts (2024). Each crop's predicted prices are divided by their mean, enabling cross-crop comparison. Peaks occur in different months---Cassava (Jan), Corn (Feb), Soybean (Mar), Green Bean (Sep)---which enables non-overlapping crop rotation.}}{11}{figure.16}\protected@file@percent }
\newlabel{fig:overlap}{{16}{11}{Normalized RW-LSTM forecasts (2024). Each crop's predicted prices are divided by their mean, enabling cross-crop comparison. Peaks occur in different months---Cassava (Jan), Corn (Feb), Soybean (Mar), Green Bean (Sep)---which enables non-overlapping crop rotation}{figure.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Unoptimized Gantt chart. Each crop is placed at its peak-optimal planting--harvest window. Cassava, corn, and soybean overlap during Oct 2023--Mar 2024, indicated by hatched regions.}}{11}{figure.17}\protected@file@percent }
\newlabel{fig:gantt_unopt}{{17}{11}{Unoptimized Gantt chart. Each crop is placed at its peak-optimal planting--harvest window. Cassava, corn, and soybean overlap during Oct 2023--Mar 2024, indicated by hatched regions}{figure.17}{}}
